<?xml version="1.0" encoding="utf-8" ?>
<templates>
    <t
        t-inherit="currency_account.TaxTotalsCompanyCurrencyWidget"
        t-inherit-mode="extension"
    >
        <xpath
            expr="//tr[.//span[@name='amount_total']]"
            position="replace"
        >
            <t
                t-if="'l10n_ve_igtf_total_without_igtf_currency' in this.taxTotals"
            >
                <tr>
                    <td class="o_td_label">
                        <label class="o_form_label o_tax_total_label"
                        >Total</label>
                    </td>
                    <td class="o_list_monetary">
                        <span
                            name="l10n_ve_igtf_total_without_igtf"
                            t-out="this.formatAmount(this.taxTotals.l10n_ve_igtf_total_without_igtf_currency, false)"
                            style="font-weight: 600; white-space: nowrap;"
                        />
                    </td>
                    <t t-if="this.taxTotals.display_in_company_currency">
                        <td class="o_list_monetary ps-5">
                            <span
                                name="l10n_ve_igtf_total_without_igtf_company"
                                t-out="this.formatAmount(this.taxTotals.l10n_ve_igtf_total_without_igtf, true)"
                                style="font-weight: 600; white-space: nowrap;"
                            />
                        </td>
                    </t>
                </tr>
                <tr>
                    <td class="o_td_label">
                        <label
                            class="o_form_label o_tax_total_label"
                        >Total con IGTF</label>
                    </td>
                    <td class="o_list_monetary">
                        <span
                            name="amount_total"
                            t-att-class="{'oe_subtotal_footer_separator': this.taxTotals.has_tax_groups}"
                            t-out="this.formatAmount(this.taxTotals.total_amount_currency || 0, false)"
                            style="font-size: 1.3em; font-weight: bold; white-space: nowrap;"
                        />
                    </td>
                    <t t-if="this.taxTotals.display_in_company_currency">
                        <td class="o_list_monetary ps-5">
                            <span
                                name="amount_total_company"
                                t-att-class="{'oe_subtotal_footer_separator': this.taxTotals.has_tax_groups}"
                                t-out="this.formatAmount(this.taxTotals.total_amount || 0, true)"
                                style="font-size: 1.3em; font-weight: bold; white-space: nowrap;"
                            />
                        </td>
                    </t>
                </tr>
            </t>
            <t t-else="">
                <tr>
                    <td class="o_td_label">
                        <label class="o_form_label o_tax_total_label"
                        >Total</label>
                    </td>
                    <td class="o_list_monetary">
                        <span
                            name="amount_total"
                            t-att-class="{'oe_subtotal_footer_separator': this.taxTotals.has_tax_groups}"
                            t-out="this.formatAmount(this.taxTotals.total_amount_currency || 0, false)"
                            style="font-size: 1.3em; font-weight: bold; white-space: nowrap;"
                        />
                    </td>
                    <t t-if="this.taxTotals.display_in_company_currency">
                        <td class="o_list_monetary ps-5">
                            <span
                                name="amount_total_company"
                                t-att-class="{'oe_subtotal_footer_separator': this.taxTotals.has_tax_groups}"
                                t-out="this.formatAmount(this.taxTotals.total_amount || 0, true)"
                                style="font-size: 1.3em; font-weight: bold; white-space: nowrap;"
                            />
                        </td>
                    </t>
                </tr>
            </t>
        </xpath>
    </t>
</templates>
