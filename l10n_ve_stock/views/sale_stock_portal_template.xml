<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template
        id="sale_order_portal_content_l10n_ve_invoice_control"
        name="VE portal: N° control en facturas"
        inherit_id="sale.sale_order_portal_template"
    >
        <xpath
            expr="//div[@id='sidebar_invoices']//small[@t-field='inv.invoice_date']/.."
            position="after"
        >
            <t
                t-set="ve_control_number"
                t-value="inv.l10n_ve_portal_control_number_display()"
            />
            <div
                t-if="sale_order.country_code == 'VE' and ve_control_number"
                class="small"
            >
                N° de control:
                <span class="text-danger fw-bold" t-out="ve_control_number" />
            </div>
        </xpath>
        <xpath
            expr="//div[hasclass('d-lg-none')]//a[@t-att-href='inv.get_portal_url()']"
            position="after"
        >
            <t
                t-set="ve_control_number"
                t-value="inv.l10n_ve_portal_control_number_display()"
            />
            <div
                t-if="sale_order.country_code == 'VE' and ve_control_number"
                class="small"
            >
                N° de control:
                <span class="text-danger fw-bold" t-out="ve_control_number" />
            </div>
        </xpath>
    </template>

    <template
        id="sale_order_portal_content_l10n_ve_delivery_control"
        name="VE portal: N° control en entregas"
        inherit_id="sale_stock.sale_order_portal_content_inherit_sale_stock"
    >
        <xpath
            expr="//div[@name='delivery_details']"
            position="inside"
        >
            <t
                t-set="ve_control_number"
                t-value="picking.l10n_ve_portal_control_number_display()"
            />
            <div
                t-if="sale_order.country_code == 'VE' and ve_control_number"
                class="small w-100"
            >
                N° de control:
                <span class="text-danger fw-bold" t-out="ve_control_number" />
            </div>
        </xpath>
    </template>
</odoo>
