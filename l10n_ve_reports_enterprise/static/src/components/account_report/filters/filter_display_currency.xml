<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t
        t-name="l10n_ve_reports_enterprise.AccountReportFilterRoundingUnitDisplayCurrency"
        t-inherit="account_reports.AccountReportFilterRoundingUnit"
        t-inherit-mode="extension"
    >
        <xpath expr="//Dropdown" position="after">
            <t
                t-if="this.controller.cachedFilterOptions().available_currencies and this.controller.cachedFilterOptions().available_currencies.length > 1"
            >
                <div id="filter_display_currency">
                    <t t-call="l10n_ve_reports_enterprise.AccountReportFilterDisplayCurrency" />
                </div>
            </t>
        </xpath>
    </t>

    <t t-name="l10n_ve_reports_enterprise.AccountReportFilterDisplayCurrency">
        <div class="d-flex gap-1 align-items-center">
            <Dropdown menuClass="'account_report_filter display_currency'">
                <button
                    class="btn btn-secondary"
                    t-att-disabled="this.currencyDateLoadingState.isLoading"
                >
                    <i class="oi me-1" data-icon="payments" />
                    <t t-out="this.selectedDisplayCurrencyName" />
                </button>

                <t t-set-slot="content">
                    <t
                        t-foreach="this.controller.cachedFilterOptions().available_currencies"
                        t-as="currency"
                        t-key="currency.id"
                    >
                        <DropdownItem
                            class="{ 'selected': (this.controller.cachedFilterOptions().display_currency_id == currency.id) }"
                            onSelected="() => this.filterDisplayCurrency(currency.id)"
                        >
                            <t t-out="currency.name + ' (' + currency.symbol + ')'" />
                        </DropdownItem>
                    </t>
                </t>
            </Dropdown>

            <Dropdown menuClass="'account_report_filter currency_rate_date_type'">
                <button
                    class="btn btn-secondary"
                    t-att-disabled="this.currencyDateLoadingState.isLoading"
                >
                    <i class="oi oi-filled me-1" data-icon="calendar_today" />
                    <t t-out="this.selectedCurrencyRateDateTypeName" />
                </button>

                <t t-set-slot="content">
                    <DropdownItem
                        class="{ 'selected': (this.controller.cachedFilterOptions().currency_rate_date_type == 'current') }"
                        onSelected="() => this.filterCurrencyRateDateType('current')"
                    >
                        <t t-out="this.currencyRateDateTypeLabel('current')" />
                    </DropdownItem>
                    <DropdownItem
                        class="{ 'selected': (this.controller.cachedFilterOptions().currency_rate_date_type == 'document') }"
                        onSelected="() => this.filterCurrencyRateDateType('document')"
                    >
                        <t t-out="this.currencyRateDateTypeLabel('document')" />
                    </DropdownItem>
                    <DropdownItem
                        class="{ 'selected': (this.controller.cachedFilterOptions().currency_rate_date_type == 'manual') }"
                        onSelected="() => this.filterCurrencyRateDateType('manual')"
                    >
                        <t t-out="this.currencyRateDateTypeLabel('manual')" />
                    </DropdownItem>
                </t>
            </Dropdown>

            <t t-if="this.controller.cachedFilterOptions().currency_rate_date_type == 'manual'">
                <DateTimeInput
                    type="'date'"
                    value="this.currencyRateDateValue"
                    onChange="(date) => this.onCurrencyRateDateChanged(date)"
                    disabled="this.currencyDateLoadingState.isLoading"
                />
            </t>

            <t t-if="this.currencyDateLoadingState.isLoading">
                <i
                    class="oi oi-spin text-primary"
                    data-icon="progress_activity"
                    title="Updating report..."
                />
            </t>
        </div>
    </t>
</templates>
