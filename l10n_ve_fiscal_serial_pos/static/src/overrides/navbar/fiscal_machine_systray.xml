<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_fiscal_serial_pos.PosFiscalMachineSystray">
        <Dropdown onOpened.bind="this.onDropdownOpened">
            <button
                class="o_l10n_ve_fiscal_systray_btn btn btn-light btn-lg lh-lg d-flex align-items-center gap-1"
                type="button"
                title="Estado de la máquina fiscal"
            >
                <i class="oi oi-fw oi-lg" data-icon="print" role="img" aria-label="Máquina fiscal"/>
                <span t-att-class="this.statusClass"/>
                <span class="d-none d-xl-inline small" t-out="this.statusLabel"/>
            </button>
            <t t-set-slot="content">
                <div class="o_l10n_ve_fiscal_systray_panel p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="fw-bold">Máquina fiscal</span>
                        <span
                            class="badge rounded-pill"
                            t-att-class="{
                                'text-bg-success': this.state.status === 'connected',
                                'text-bg-danger': (this.state.status === 'error' and !this.state.portOpen) or this.state.status === 'unsupported',
                                'text-bg-warning': this.state.status === 'connecting' or (this.state.status === 'error' and this.state.portOpen) or (this.state.status === 'idle' and this.state.portAuthorized),
                                'text-bg-secondary': this.state.status === 'idle' and !this.state.portAuthorized,
                            }"
                            t-out="this.statusLabel"
                        />
                    </div>
                    <t t-if="this.state.machine">
                        <div class="small mb-2">
                            <div t-if="this.invoiceJournalLabel">
                                <span class="text-muted">Diario:</span>
                                <span class="ms-1" t-out="this.invoiceJournalLabel"/>
                            </div>
                            <div>
                                <span class="text-muted">Equipo:</span>
                                <span class="ms-1" t-out="this.state.machine.name"/>
                            </div>
                            <div t-if="this.state.machine.registered_serial">
                                <span class="text-muted">Serial:</span>
                                <span class="ms-1" t-out="this.state.machine.registered_serial"/>
                            </div>
                            <div>
                                <span class="text-muted">Estado del puerto:</span>
                                <span
                                    class="ms-1 fw-semibold"
                                    t-att-class="{
                                        'text-success': this.state.portOpen,
                                        'text-warning': !this.state.portOpen and this.state.portAuthorized,
                                        'text-danger': !this.state.portOpen and !this.state.portAuthorized,
                                    }"
                                    t-out="this.portStatusLabel"
                                />
                            </div>
                            <div t-if="this.state.portLabel or this.state.machine.serial_port">
                                <span class="text-muted">Puerto:</span>
                                <span
                                    class="ms-1"
                                    t-out="this.state.portLabel or this.state.machine.serial_port"
                                />
                            </div>
                            <div t-if="this.state.enqStatusLabel">
                                <span class="text-muted">Estado ENQ:</span>
                                <span class="ms-1" t-out="this.state.enqStatusLabel"/>
                            </div>
                            <div t-if="this.state.enqErrorLabel">
                                <span class="text-muted">Error ENQ:</span>
                                <span class="ms-1" t-out="this.state.enqErrorLabel"/>
                            </div>
                            <div t-if="this.state.machine.last_connection">
                                <span class="text-muted">Última conexión registrada:</span>
                                <span class="ms-1" t-out="this.state.machine.last_connection"/>
                            </div>
                            <div class="text-muted mt-1">
                                Última comprobación:
                                <span t-out="this.lastCheckLabel"/>
                            </div>
                            <div t-if="this.state.portOpen" class="text-muted mt-1">
                                Vigilancia ENQ:
                                <span t-out="this.state.heartbeatCount"/>
                                ciclos
                            </div>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="small text-muted mb-2">
                            No hay máquina fiscal configurada para esta compañía.
                        </div>
                    </t>
                    <div
                        t-if="this.state.machine and this.state.message"
                        class="alert py-2 px-2 small mb-2"
                        t-att-class="{
                            'alert-success': this.state.status === 'connected',
                            'alert-danger': this.state.status === 'error' or this.state.status === 'unsupported',
                            'alert-warning': this.state.status === 'connecting',
                            'alert-secondary': this.state.status === 'idle',
                        }"
                        t-out="this.state.message"
                    />
                    <div class="d-flex flex-wrap gap-2">
                        <button
                            t-if="this.state.machine"
                            type="button"
                            class="btn btn-sm btn-primary"
                            t-att-disabled="this.state.busy"
                            t-on-click="this.onCheckConnection"
                        >
                            Verificar conexión
                        </button>
                        <button
                            t-if="this.state.machine"
                            type="button"
                            class="btn btn-sm btn-secondary"
                            t-att-disabled="this.state.busy"
                            t-on-click="this.onConnect"
                        >
                            Conectar
                        </button>
                    </div>
                </div>
            </t>
        </Dropdown>
    </t>

    <t t-name="l10n_ve_fiscal_serial_pos.Navbar" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//button[.//i[contains(@class,'fa-barcode')]]" position="after">
            <PosFiscalMachineSystray
                t-if="showFiscalMachineSystray"
                t-props="{
                    fiscalMachineId: fiscalSystrayMachineId,
                    invoiceJournalId: fiscalSystrayJournalId,
                }"
                t-key="fiscalSystrayMachineId or 'l10n_ve_fiscal_serial_pos_systray'"
            />
        </xpath>
    </t>
</templates>
