<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t
        t-name="l10n_ve_fiscal_serial_pos.ClosePosPopup"
        t-inherit="point_of_sale.ClosePosPopup"
        t-inherit-mode="extension"
    >
        <xpath
            expr="//button[contains(@class, 'button')][@t-on-click='this.downloadSalesReport']"
            position="after"
        >
            <t t-if="this.l10nVeShowFiscalReports">
                <select
                    class="form-select"
                    t-att-class="this.ui.isSmall ? 'w-100' : ''"
                    style="max-width: 16rem;"
                    t-att-value="this.l10nVeFiscalClose.machineId || ''"
                    t-on-change="this.l10nVeOnFiscalMachineChange"
                    title="Máquinas autorizadas en este navegador para reportes X/Z"
                >
                    <option value="" disabled="disabled" t-out="'Máquina autorizada'"/>
                    <t t-foreach="this.l10nVeFiscalClose.machines" t-as="machine" t-key="machine.id">
                        <option
                            t-att-value="machine.id"
                            t-out="(machine.name or '') + (machine.registered_serial ? ' (' + machine.registered_serial + ')' : '')"
                        />
                    </t>
                </select>
                <button
                    class="button btn btn-secondary"
                    t-att-class="this.ui.isSmall ? 'w-100' : 'btn-lg'"
                    t-on-click="this.l10nVePrintXReport"
                >
                    Reporte X
                </button>
                <button
                    class="button btn btn-secondary"
                    t-att-class="this.ui.isSmall ? 'w-100' : 'btn-lg'"
                    t-on-click="this.l10nVePrintZReport"
                >
                    Reporte Z
                </button>
            </t>
        </xpath>
    </t>
</templates>
