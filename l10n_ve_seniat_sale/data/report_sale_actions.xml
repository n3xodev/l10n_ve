<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <delete model="ir.actions.report" search="[('report_name', '=', 'l10n_ve_seniat_sale.report_saleorder_ve')]" />
    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="name">Presupuesto / Pedido de venta</field>
        <field name="report_name">sale.report_saleorder</field>
        <field
            name="print_report_name"
        >('Presupuesto - %s' if object.state in ('draft', 'sent') else 'Pedido de venta - %s') % (object.name,)</field>
        <field name="paperformat_id" eval="False" />
    </record>
    <!-- Odoo 20: sale_pdf_quote_builder unbinds sale.action_report_saleorder and binds this one -->
    <record id="sale_pdf_quote_builder.action_report_saleorder_raw" model="ir.actions.report">
        <field name="name">Presupuesto / Pedido de venta</field>
        <field
            name="print_report_name"
        >('Presupuesto - %s' if object.state in ('draft', 'sent') else 'Pedido de venta - %s') % (object.name,)</field>
        <field name="paperformat_id" eval="False" />
    </record>
    <record id="sale.action_report_pro_forma_invoice" model="ir.actions.report">
        <field name="binding_model_id" ref="sale.model_sale_order" />
        <field name="binding_type">report</field>
    </record>
</odoo>
