<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos.TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <!-- Venezuelan documents are printed from the invoice (or the fiscal
             machine), never as a POS receipt. -->
        <xpath expr="//button[@t-on-click='() =&gt; this.doPrint.call(_selectedSyncedOrder)']" position="attributes">
            <attribute name="t-if">!this.isVenezuelaPos</attribute>
        </xpath>
    </t>
</templates>
