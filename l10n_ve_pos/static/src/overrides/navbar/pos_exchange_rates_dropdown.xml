<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos.PosExchangeRatesDropdown">
        <Dropdown>
            <button class="btn btn-light btn-lg lh-lg d-flex align-items-center" type="button">
                <i class="oi oi-fw oi-lg" data-icon="payments" t-att-title="this.exchangeRatesTitle"/>
                <span class="ms-1" t-out="this.ratesColonLabel"/>
                <span t-if="this.displayCurrencyName" class="ms-1 fw-bold" t-out="this.displayCurrencyName"/>
                <span t-if="this.displayCurrencyRate" class="ms-1" t-out="this.displayCurrencyRate"/>
            </button>
            <t t-set-slot="content">
                <div class="o_l10n_ve_pos_exchange_rates p-2" style="min-width: 250px;">
                    <t t-if="this.state.loading">
                        <DropdownItem>
                            <span t-out="this.loadingLabel"/>
                        </DropdownItem>
                    </t>
                    <t t-elif="this.state.rates.length">
                        <div class="fw-bold px-3 py-1" t-out="this.dateLine"/>
                        <div class="fw-bold px-3 py-1" t-out="this.ratesRefLine"/>
                        <div class="px-3">
                            <table class="table table-sm table-borderless m-0">
                                <tbody>
                                    <t t-foreach="this.state.rates" t-as="rate" t-key="rate_index">
                                        <tr>
                                            <td class="p-1">
                                                <t t-out="rate.name"/> (<t t-out="rate.symbol"/>)
                                            </td>
                                            <td class="p-1 text-end">
                                                1 <t t-out="rate.symbol"/>  ≈ <t t-out="rate.rate"/>
                                                <t t-out="rate.company_currency_symbol"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>
                    <t t-else="">
                        <DropdownItem>
                            <span t-out="this.emptyLabel"/>
                        </DropdownItem>
                    </t>
                </div>
            </t>
        </Dropdown>
    </t>
</templates>
