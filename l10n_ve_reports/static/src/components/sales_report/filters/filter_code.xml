<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="l10n_ve_reports.SalesReportFilterCode">
        <Dropdown>
            <button class="btn btn-secondary">
                <i class="oi oi-filled me-1" data-icon="filter_alt" /> Codes: <t t-esc="selectedEcTaxName" />
            </button>

            <t t-set-slot="content">
                <t
                    t-foreach="controller.options.ec_tax_filter_selection"
                    t-as="ecTax"
                    t-key="ecTax_index"
                >
                    <DropdownItem
                        class="{ 'selected':  ecTax.selected }"
                        onSelected="() => this.filterClicked({ optionKey: 'ec_tax_filter_selection.'+ ecTax_index + '.selected', reload: true})"
                        closingMode="'none'"
                        t-out="ecTax.name"
                    />
                </t>
            </t>
        </Dropdown>
    </t>
</templates>
