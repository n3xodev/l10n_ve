<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t
        t-name="l10n_ve_reports.JournalReportLineName"
        t-inherit="l10n_ve_reports.AccountReportLineNameCustomizable"
    >
        <xpath
            expr="//td[@data-id='line_name']//div[@data-id='content']"
            position="replace"
        >
            <t t-if="'journal_id' in this.props.line and 'account_id' in this.props.line">
                <a
                    class="link"
                    t-on-click="
                    (ev) => this.controller.reportAction(
                        ev,
                        'journal_report_action_open_account_move_lines_by_account',
                        {
                            journal_id: this.props.line.journal_id,
                            account_id: this.props.line.account_id
                        }
                    )"
                >
                    <t t-out="this.props.line.name" />
                </a>
            </t>
            <t t-else="">
                <t t-out="this.props.line.name" />

                <t t-if="'journal_id' in this.props.line">
                    <button
                        class="btn btn_action"
                        t-on-click="(ev) => this.controller.reportAction(ev, 'journal_report_open_aml_by_move', {
                            journal_id: this.props.line.journal_id,
                            line_id: this.props.line.id,
                        })"
                    >
                        Audit
                    </button>
                </t>
            </t>
        </xpath>
    </t>
</templates>
