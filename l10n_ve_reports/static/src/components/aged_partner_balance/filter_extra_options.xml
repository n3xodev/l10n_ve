<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t
        t-name="l10n_ve_reports.AgedPartnerBalanceFilterExtraOptions"
        t-inherit="l10n_ve_reports.AccountReportFilterExtraOptions"
    >
        <xpath
            expr="//DropdownItem[contains(@class, 'filter_show_all_hook')]"
            position="after"
        >
            <DropdownItem
                t-if="this.controller.options.multi_currency"
                class="{ 'selected': this.controller.options.show_currency }"
                onSelected="() => this.filterClicked({ optionKey: 'show_currency', reload: true})"
                closingMode="'none'"
            >
                Show Currency
            </DropdownItem>
            <DropdownItem
                class="{ 'selected': this.controller.options.show_account }"
                onSelected="() => this.filterClicked({ optionKey: 'show_account', reload: true})"
                closingMode="'none'"
            >
                Show Account
            </DropdownItem>
        </xpath>
    </t>
</templates>
