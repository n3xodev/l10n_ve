<templates xml:space="preserve">
    <t t-name="l10n_ve_reports.redirectAction">
        <Dialog size="'md'">
            <div role="alert">
                <p class="text-prewrap" t-out="this.props.action.params.message" />
            </div>
            <t t-set-slot="footer">
                <button
                    class="btn btn-primary"
                    t-on-click="this.openClientAction"
                    t-out="this.props.action.params.button_text"
                />
                <button class="btn btn-secondary" t-on-click="this.close">Cancel</button>
            </t>
        </Dialog>
    </t>
</templates>
