<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="l10n_ve_reports.MoveLineListView" t-inherit="web.ListView">
        <xpath expr="//div[@t-ref='this.rootRef']" position="attributes" type="add">
            <attribute name="class" add="o_move_line_list_view" separator=" " />
        </xpath>
        <xpath expr="//t[@t-component='this.props.Renderer']" position="attributes">
            <attribute name="setSelectedRecord.bind">this.setSelectedRecord</attribute>
        </xpath>
        <xpath expr="//Layout" position="inside">
            <t t-call="l10n_ve_reports.AttachmentPreview" />
        </xpath>
    </t>

    <t t-name="l10n_ve_reports.AttachmentPreview">
        <div
            t-if="this.previewEnabled"
            class="o_attachment_preview d-print-none"
            t-att-class="{'hidden': !this.attachmentPreviewState.displayAttachment || this.mailPopoutService.externalWindow}"
        >
            <t
                t-if="this.attachmentPreviewState.displayAttachment || this.mailPopoutService.externalWindow"
            >
                <t
                    t-if="this.attachmentPreviewState.thread and this.attachmentPreviewState.thread.attachmentsInWebClientView.length > 0"
                >
                    <AttachmentViewMoveLine
                        thread="this.thread"
                        openInPopout="false"
                        setPopout.bind="this.setPopout"
                    />
                </t>
                <t t-elif="!this.attachmentPreviewState.selectedRecord">
                    <p class="text-center">Choose a line to preview its attachments.</p>
                </t>
                <t t-else="">
                    <p class="text-center">No attachments linked.</p>
                </t>
            </t>
            <div
                class="o_attachment_control toggle"
                t-on-click="this.togglePreview"
                t-if="!this.mailPopoutService.externalWindow"
            />
        </div>
        <t t-else="">
            <div class="o_popout_icon" t-on-click="() => this.setPopout(true)">
                <i class="oi" data-icon="fullscreen_exit" title="Open attachment in pop out" />
            </div>
            <t t-if="this.popout.active">
                <div
                    class="o_attachment_preview d-print-none"
                    t-if="this.attachmentPreviewState.thread?.attachmentsInWebClientView.length"
                >
                    <AttachmentViewMoveLine
                        thread="this.thread"
                        openInPopout="true"
                        setPopout.bind="this.setPopout"
                    />
                </div>
            </t>
        </t>
    </t>
</templates>
