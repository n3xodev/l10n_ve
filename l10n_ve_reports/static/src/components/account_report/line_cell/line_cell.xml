<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="l10n_ve_reports.AccountReportLineCell">
        <t t-call="{{ this.env.template('AccountReportLineCell') }}" />
    </t>

    <t t-name="l10n_ve_reports.AccountReportLineCellCustomizable">
        <td
            data-id="line_cell"
            class="line_cell"
            t-att-class="this.cellClasses"
            t-att-data-expression_label="this.props.cell.expression_label"
        >
            <div class="wrapper">
                <t t-if="!this.controller.filters.show_totals or !this.props.line.unfolded">
                    <t t-if="this.props.cell.info_popup_data">
                        <a
                            class="oi oi-filled me-2" data-icon="help"
                            t-on-click="(ev) => this.carryoverPopover(ev)"
                        />
                    </t>

                    <t t-if="this.props.cell.edit_popup_data">
                        <button
                            class="btn btn_edit me-auto"
                            t-on-click="(ev) => this.editPopover(ev)"
                        >
                            <i class="oi oi-filled" data-icon="edit" />
                        </button>
                    </t>

                    <div class="content">
                        <t t-if="this.props.cell.auditable">
                            <a t-on-click="() => this.audit()">
                                <t
                                    t-component="this.env.component('AccountReportEllipsis')"
                                    t-props="{
                                    name: this.props.cell.name?.toString(),
                                    no_format: this.props.cell.no_format,
                                    type: this.props.cell.figure_type,
                                    maxCharacters: 50,
                                }"
                                />
                            </a>
                        </t>
                        <t t-else="">
                            <t
                                t-component="this.env.component('AccountReportEllipsis')"
                                t-props="{
                                name: this.props.cell.name?.toString(),
                                no_format: this.props.cell.no_format,
                                type: this.props.cell.figure_type,
                                maxCharacters: 50,
                            }"
                            />
                        </t>
                    </div>
                </t>
            </div>
        </td>
    </t>
</templates>
