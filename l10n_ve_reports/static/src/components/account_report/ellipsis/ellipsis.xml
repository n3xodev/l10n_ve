<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="l10n_ve_reports.AccountReportEllipsis">
        <t t-call="{{ this.env.template('AccountReportEllipsis') }}" />
    </t>

    <t t-name="l10n_ve_reports.AccountReportEllipsisCustomizable">
        <t t-if="this.props.type === 'string'">
            <div class="name">
                <t
                    t-out="(this.props.name) ? this.props.name.substring(0, this.props.maxCharacters) : ''"
                />
            </div>

            <t t-if="this.triggersEllipsis">
                <button
                    class="btn btn_ellipsis"
                    t-on-click="(ev) => this.showEllipsisPopover(ev)"
                >
                    <i class="oi" data-icon="more_horiz" />
                </button>
            </t>
        </t>
        <t t-else="">
            <div class="name">
                <t t-out="this.props.name" />
            </div>
        </t>
    </t>
</templates>
