<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="l10n_ve_reports.AccountReportLineName">
        <t t-call="{{ this.env.template('AccountReportLineName') }}" />
    </t>

    <t t-name="l10n_ve_reports.AccountReportLineNameCustomizable">
        <td
            data-id="line_name"
            class="line_name"
            t-att-class="this.lineNameClasses"
            t-on-click="() => this.toggleFoldable()"
            t-att-colspan="this.props.line.colspan || 1"
            tabindex="-1"
            t-custom-ref="lineNameCell"
        >
            <div class="wrapper">
                <t t-if="this.props.line.unfoldable">
                    <!-- Foldable -->
                    <button
                        data-id="btn_foldable"
                        class="btn btn_foldable"
                        tabindex="-1"
                    >
                        <i
                            t-att-data-icon="this.props.line.unfolded ? 'arrow_drop_down' : 'arrow_right'"
                        />
                    </button>
                </t>
                <t t-else="">
                    <!-- This keeps the same indentation for when we don't have a btn_foldable button -->
                    <button class="btn btn_foldable_empty" tabindex="-1" />
                </t>

                <t t-if="this.props.line.action_id">
                    <!-- Actions -->
                    <a
                        class="clickable"
                        t-on-click="() => this.triggerAction()"
                        tabindex="-1"
                    >
                        <t t-out="this.props.line.name" />
                    </a>
                </t>
                <t t-elif="this.controller.isLoadMoreLine(this.props.lineIndex)">
                    <!-- Load more -->
                    <a
                        class="clickable"
                        t-on-click="() => this.loadMore()"
                        tabindex="-1"
                    >
                        <t t-out="this.props.line.name" />
                    </a>
                </t>
                <t t-else="">
                    <div data-id="content" class="content">
                        <t
                            t-component="this.env.component('AccountReportEllipsis')"
                            t-props="{
                            name: this.props.line.name?.toString(),
                            type: 'string',
                            maxCharacters: 80,
                        }"
                        />

                        <t t-if="this.props.line.visible_annotations?.length">
                            <button
                                tabindex="-1"
                                class="btn btn_annotation"
                                t-on-click="this.toggleAnnotationPopover"
                            >
                                <i class="oi oi-filled" data-icon="mode_comment" />
                            </button>
                        </t>

                        <t t-if="this.hasCaretOptions">
                            <!-- Caret options -->
                            <Dropdown position="'right-start'">
                                <button class="btn btn_dropdown" tabindex="-1">
                                    <i class="oi" data-icon="more_vert" />
                                </button>
                                <t t-set-slot="content">
                                    <div data-id="caret_options">
                                        <t
                                            t-foreach="this.caretOptions"
                                            t-as="caretOption"
                                            t-key="caretOption_index"
                                        >
                                            <DropdownItem
                                                onSelected="() => this.caretAction(caretOption)"
                                            >
                                                <t t-out="caretOption.name" />
                                            </DropdownItem>
                                        </t>

                                        <t
                                            t-if="!this.props.line.visible_annotations?.length"
                                        >
                                            <div
                                                class="o-dropdown-item dropdown-item o-navigable"
                                                t-on-click="(ev) => this.addAnnotation(ev, this.props.line.id)"
                                            >
                                                Annotate
                                            </div>
                                        </t>
                                    </div>
                                </t>
                            </Dropdown>
                        </t>

                        <t
                            data-id="line_buttons"
                            t-if="!this.props.line['hide_line_buttons']"
                        />
                    </div>
                </t>
            </div>
        </td>
    </t>
</templates>
