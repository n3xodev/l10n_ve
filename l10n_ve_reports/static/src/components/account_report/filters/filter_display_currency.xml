<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="l10n_ve_reports.AccountReportFilterDisplayCurrency">
        <div class="d-flex gap-1 align-items-center">
            <Dropdown
                menuClass="'account_report_filter display_currency'"
                onStateChanged="(isOpen) => !isOpen ? this.applyFilters('display_currency') : null"
            >
                <button
                    class="btn btn-secondary"
                    t-att-disabled="this.currencyDateLoadingState.isLoading"
                >
                    <i class="oi me-1" data-icon="payments" />
                    <t t-out="this.selectedDisplayCurrencyName" />
                </button>

                <t t-set-slot="content">
                    <t
                        t-foreach="this.controller.options.available_currencies"
                        t-as="currency"
                        t-key="currency.id"
                    >
                        <DropdownItem
                            class="{ 'selected': (this.controller.options.display_currency_id == currency.id) }"
                            onSelected="() => this.filterDisplayCurrency(currency.id)"
                        >
                            <t t-out="currency.name + ' (' + currency.symbol + ')'" />
                        </DropdownItem>
                    </t>
                </t>
            </Dropdown>

            <!-- Currency Rate Date Type Selector -->
            <Dropdown
                menuClass="'account_report_filter currency_rate_date_type'"
                onStateChanged="(isOpen) => !isOpen ? this.applyFilters('currency_rate_date_type') : null"
            >
                <button
                    class="btn btn-secondary"
                    t-att-disabled="this.currencyDateLoadingState.isLoading"
                >
                    <i class="oi oi-filled me-1" data-icon="calendar_today" />
                    <t t-out="this.selectedCurrencyRateDateTypeName" />
                </button>

                <t t-set-slot="content">
                    <DropdownItem
                        class="{ 'selected': (this.controller.options.currency_rate_date_type == 'current') }"
                        onSelected="() => this.filterCurrencyRateDateType('current')"
                    >
                        <t t-out="this.currencyRateDateTypeLabel('current')" />
                    </DropdownItem>
                    <DropdownItem
                        class="{ 'selected': (this.controller.options.currency_rate_date_type == 'document') }"
                        onSelected="() => this.filterCurrencyRateDateType('document')"
                    >
                        <t t-out="this.currencyRateDateTypeLabel('document')" />
                    </DropdownItem>
                    <DropdownItem
                        class="{ 'selected': (this.controller.options.currency_rate_date_type == 'manual') }"
                        onSelected="() => this.filterCurrencyRateDateType('manual')"
                    >
                        <t t-out="this.currencyRateDateTypeLabel('manual')" />
                    </DropdownItem>
                </t>
            </Dropdown>

            <!-- Manual Date Selector (only shown when currency_rate_date_type is 'manual') -->
            <t t-if="this.controller.options.currency_rate_date_type == 'manual'">
                <DateTimeInput
                    type="'date'"
                    value="this.currencyRateDateValue"
                    onChange="(date) => this.onCurrencyRateDateChanged(date)"
                    disabled="this.currencyDateLoadingState.isLoading"
                />
            </t>

            <!-- Loading indicator (visible for any currency-related reload) -->
            <t t-if="this.currencyDateLoadingState.isLoading">
                <i
                    class="oi oi-spin text-primary" data-icon="progress_activity"
                    title="Actualizando reporte..."
                />
            </t>
        </div>
    </t>
</templates>
