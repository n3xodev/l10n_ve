<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="l10n_ve_reports.AccountReportFilterExtraOptions">
        <Dropdown>
            <button class="btn btn-secondary">
                <i class="oi me-1" data-icon="tune" />
                <t t-if="this.selectedExtraOptions">
                    <t t-out="this.selectedExtraOptions" />
                </t>
                <t t-else="">
                    Options
                </t>
            </button>

            <t t-set-slot="content">
                <t
                    t-if="this.controller.groups.account_readonly and this.controller.filters.show_draft"
                >
                    <DropdownItem
                        class="{ 'filter_show_draft_hook': true, 'selected': this.controller.options.all_entries }"
                        onSelected="() => this.filterClicked({ optionKey: 'all_entries', reload: true})"
                        closingMode="'none'"
                    >
                        Draft Entries
                    </DropdownItem>
                </t>

                <t
                    t-if="this.controller.groups.account_readonly and this.controller.filters.show_analytic_groupby"
                >
                    <DropdownItem
                        class="{ 'selected': this.controller.options.include_analytic_without_aml }"
                        onSelected="() => this.filterClicked({ optionKey: 'include_analytic_without_aml', reload: true})"
                        closingMode="'none'"
                    >
                        Analytic Simulations
                    </DropdownItem>
                </t>

                <t t-if="this.controller.filters.show_hierarchy">
                    <DropdownItem
                        class="{ 'selected': this.controller.options.hierarchy }"
                        onSelected="() => this.filterClicked({ optionKey: 'hierarchy', reload: true})"
                        closingMode="'none'"
                    >
                        Hierarchy and Subtotals
                    </DropdownItem>
                </t>

                <t t-if="this.controller.filters.show_unreconciled">
                    <DropdownItem
                        class="{ 'selected': this.controller.options.unreconciled }"
                        onSelected="() => this.filterClicked({ optionKey: 'unreconciled', reload: true})"
                        closingMode="'none'"
                    >
                        Unreconciled Entries
                    </DropdownItem>
                </t>

                <t t-if="this.controller.filters.show_all">
                    <DropdownItem
                        class="{ 'filter_show_all_hook': true, 'selected': this.controller.options.unfold_all }"
                        onSelected="() => this.filterClicked({ optionKey: 'unfold_all', reload: true})"
                        closingMode="'none'"
                    >
                        Unfold All
                    </DropdownItem>
                </t>

                <t t-if="this.controller.options.integer_rounding">
                    <DropdownItem
                        class="{ 'selected': this.controller.options.integer_rounding_enabled }"
                        onSelected="() => this.filterClicked({ optionKey: 'integer_rounding_enabled'})"
                        closingMode="'none'"
                    >
                        Integer Rounding
                    </DropdownItem>
                </t>

                <div class="dropdown-divider" t-if="this.hasUIFilter" />

                <t t-if="this.controller.filters.show_hide_0_lines !== 'never'">
                    <DropdownItem
                        class="{ 'selected': this.controller.options.hide_0_lines }"
                        onSelected="() => this.toggleHideZeroLines()"
                    >
                        Hide lines at 0
                    </DropdownItem>
                </t>

                <t t-if="'horizontal_split' in this.controller.options">
                    <DropdownItem
                        class="{ 'selected': this.controller.options.horizontal_split }"
                        onSelected="() => this.toggleHorizontalSplit()"
                    >
                        Split Horizontally
                    </DropdownItem>
                </t>
            </t>
        </Dropdown>
    </t>
</templates>
